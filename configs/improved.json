{
  "text_model": "distilbert/distilbert-base-uncased",
  "asr_model": "openai/whisper-tiny",
  "audio_model": "facebook/wav2vec2-base-960h",
  "sample_rate": 16000,
  "max_audio_seconds": 12.0,
  "max_text_tokens": 160,
  "hidden_dim": 256,
  "dropout": 0.3,
  "freeze_encoders": false,
  "unfreeze_text_layers": 2,
  "unfreeze_audio_layers": 2,
  "batch_size": 2,
  "epochs": 10,
  "early_stopping_patience": 3,
  "learning_rate": 0.0002,
  "encoder_learning_rate": 0.00001,
  "weight_decay": 0.02,
  "gradient_accumulation_steps": 8,
  "audio_augmentation": true,
  "mixed_precision": true,
  "regression_loss_weight": 0.25,
  "seed": 73,
  "emotion_labels": ["happiness", "sadness", "anger", "fear", "disgust", "surprise", "neutral"],
  "sarcasm_enabled": false
}
